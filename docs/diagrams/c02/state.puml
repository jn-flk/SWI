@startuml
!pragma layout smetana
title Stavový diagram
hide empty description

state DRAFT #FFE8B3 : blokuje sedadla
state PENDING_APPROVAL #FFE8B3 : blokuje sedadla
state CONFIRMED #FFE8B3 : blokuje sedadla
state REJECTED
state EXPIRED
state CANCELLED

[*] --> DRAFT : create (OP-01)\n[sedadla volná a aktivní]\n/ zablokovat sedadla

DRAFT --> CONFIRMED : confirm (OP-03)\n[počet sedadel ≤ 10\n a není celý sál]
DRAFT --> PENDING_APPROVAL : confirm (OP-03)\n[počet sedadel > 10\n nebo celý sál]
DRAFT --> DRAFT : validate hold (OP-01a)\n[při odeslání kontaktních údajů]\n/ hold_until se nemění
DRAFT --> CANCELLED : cancel (OP-04)\n[now < start (BR-03)]\n/ uvolnit sedadla
DRAFT --> EXPIRED : hold_until vypršel\n/ uvolnit sedadla

PENDING_APPROVAL --> CONFIRMED : approve (OP-05)\n[schvalovatel oprávněn]
PENDING_APPROVAL --> REJECTED : reject (OP-05)\n[schvalovatel oprávněn]\n/ uvolnit sedadla
PENDING_APPROVAL --> EXPIRED : vypršení lhůty schválení (24 h)\n/ uvolnit sedadla
PENDING_APPROVAL --> CANCELLED : cancel (OP-04)\n[now < start (BR-03)]\n/ uvolnit sedadla

CONFIRMED --> CANCELLED : cancel (OP-04)\n[now < start (BR-03)]\n/ uvolnit sedadla

REJECTED --> [*]
EXPIRED --> [*]
CANCELLED --> [*]

note right of DRAFT
  Sedadla se blokují už při vytvoření
  (atomicky s kontrolou dostupnosti) –
  zabraňuje souběhu dvou uživatelů
  o stejné sedadlo.
  Hold je pevně 15 minut od vytvoření.
  Aktivita a přechody mezi kroky
  deadline neprodlužují.
end note

note right of PENDING_APPROVAL
  Rozšíření pro hromadné rezervace
  (počet sedadel > 10 nebo celý sál) –
  vyžaduje ruční schválení do 24 h.
  Sedadla zůstávají blokovaná, aby
  schválení nemohlo skončit kolizí.
end note

legend right
  <back:#FFE8B3>   </back> stav blokuje sedadla
  ostatní koncové stavy sedadla neblokují
endlegend
@enduml
