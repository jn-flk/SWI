@startuml
title G2 — TO-BE statická architektura
left to right direction
skinparam componentStyle rectangle

package "Reservation System" {
  component "Správa rezervací\nživotní cyklus + oprávnění\nvlastní: stav životního cyklu" as RM
  component "Dostupnost a alokace\ndostupnost + blokování sedadel\nvlastní: invariant aktivní alokace" as AA
  component "Schvalovací workflow\nschvalovací politika + rozhodnutí\nvlastní: rozhodnutí/lhůta schválení" as AW
  component "Plánovač expirace\nspouštění expirace" as ES
  component "Integrace notifikací\npost-commit adaptér" as NI
  database "Relační persistence\nDjango ORM / SQLite" as DB
}

component "Služba notifikací" as NS

RM --> AA : vytvoření alokace /\nuvolnění sedadel
RM --> AW : vyhodnocení schválení /\npožadavek na rozhodnutí
AW --> RM : přechod schválit nebo zamítnout
ES --> RM : expirace rezervace
RM --> NI : událost po commitu
RM --> DB : uložení životního cyklu
AA --> DB : uložení alokací
AW --> DB : uložení lhůty
NI --> NS : požadavek na notifikaci

note right of RM
  ADR: jedna Django aplikace;
  business zápisy procházejí services.py.
end note
note bottom of AA
  ADR: unikátnost aktivní alokace je
  vynucena podmíněným databázovým constraintem.
end note
@enduml
