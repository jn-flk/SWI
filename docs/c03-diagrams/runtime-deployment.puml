@startuml
title G4 — Mapování runtime a nasazení
left to right direction
skinparam componentStyle rectangle

node "Aplikační hostitel" {
  artifact "Django rezervační aplikace\nproces" as App {
    component "Správa rezervací" as RM
    component "Dostupnost a alokace" as AA
    component "Schvalovací workflow" as AW
    component "Plánovač expirace" as ES
    component "Integrace notifikací" as NI
  }
}

database "SQLite databáze" as DB
component "Django autentizace" as Auth
component "Služba notifikací" as NS

RM --> DB : čtení/zápis
AA --> DB : čtení/zápis
AW --> DB : čtení/zápis
ES --> DB : čtení/zápis
RM --> Auth : autorizace
NI --> NS : požadavek na notifikaci
@enduml
